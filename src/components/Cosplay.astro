---
import type { Lang } from "../data/portfolio";
import type { Character } from "../data/cosplay";
interface Props {
  lang: Lang;
  character?: Character;
}
const { lang, character } = Astro.props;
const target = `https://thomasdlynn.dev/kayyalis-cosplay/${lang === "th" ? "th/" : ""}${character ? character.id + "/" : ""}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Kayyalis has a new home</title>
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body>
    <h1>Kayyalis has a new home ✿</h1>
    <p>
      <a href={target}>
        {lang === "th"
          ? "ไปที่พอร์ตคอสเพลย์ Kayyalis"
          : "Visit Kayyalis’s independent cosplay portfolio"}
      </a>
    </p>
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search + location.hash);
    </script>
  </body>
</html>
