---
import { Image } from "astro:assets";
import { photo } from "../data/images";
interface Props {
  name: string;
  alt: string;
  hero?: boolean;
  class?: string;
  sizes?: string;
}
const {
  name,
  alt,
  hero = false,
  class: className = "",
  sizes = "(max-width: 700px) 90vw, 50vw",
} = Astro.props;
const src = photo(name);
---

<Image
  src={src}
  alt={alt}
  class={className}
  widths={[320, 480, Math.min(800, src.width)]}
  sizes={sizes}
  format="webp"
  quality={80}
  loading={hero ? "eager" : "lazy"}
  decoding="async"
  fetchpriority={hero ? "high" : "auto"}
/>
