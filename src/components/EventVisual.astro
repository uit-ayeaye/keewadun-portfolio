---
import PreviewVideo from "./PreviewVideo.astro";
import { previewClipFor, posterURL, posterPosition } from "../data/videos";
import Photo from "./Photo.astro";
import { t, type EventCredit, type Lang } from "../data/portfolio";
const {
  event,
  lang,
  hero = false,
  preview = true,
} = Astro.props as {
  event: EventCredit;
  lang: Lang;
  hero?: boolean;
  preview?: boolean;
};
const clip = previewClipFor(event.id);
---

<figure
  class:list={[
    "event-visual",
    `visual-${event.category}`,
    { "portrait-visual": !event.image },
  ]}
>
  {preview && clip ? (
    <img
      src={posterURL(clip)}
      alt={clip[lang]}
      style={`object-position:${posterPosition(clip)}`}
      width="720"
      height="480"
      loading={hero ? "eager" : "lazy"}
      decoding="async"
    />
  ) : (
    <Photo
      name={event.image || "dada-portrait.jpg"}
      alt={
        event.image
          ? event[lang]
          : t(
              lang,
              "Dada — portrait, not a photograph of this event",
              "ภาพบุคคลของ Dada ไม่ใช่ภาพจากงานนี้",
            )
      }
      hero={hero}
      sizes="(max-width: 650px) 90vw, (max-width: 1000px) 44vw, 30vw"
    />
  )}
  {preview && clip && <PreviewVideo clip={clip} />}
  {!event.image && (
    <>
      <span class="visual-orbit" aria-hidden="true">
        ✳
      </span>
      <figcaption>
        {t(lang, "PORTRAIT · EVENT PHOTO TO COME", "ภาพบุคคล · รอภาพจากงาน")}
      </figcaption>
    </>
  )}
</figure>
