---
import { type Lang, t, eventPath } from "../data/portfolio";
import { type VideoClip, videoURL, posterURL, duration } from "../data/videos";
const { clips, lang } = Astro.props as { clips: VideoClip[]; lang: Lang };
---
<dialog class="video-dialog" id="video-dialog" aria-labelledby="video-title">
  <button type="button" class="dialog-close" data-close aria-label={t(lang, "Close video", "ปิดวิดีโอ")}>×</button>
  <div class="video-dialog-content"></div>
</dialog>
{clips.map(clip => (
  <template id={`video-${clip.id}`}>
    <div class="video-player-shell">
      <video controls playsinline preload="none" poster={posterURL(clip)} aria-label={clip[lang]}>
        <source src={videoURL(clip)} type="video/mp4" />
        <a href={videoURL(clip)}>{t(lang, "Open video", "เปิดวิดีโอ")}</a>
      </video>
      <span class="video-buffer" aria-hidden="true">✳</span>
    </div>
    <div class="video-dialog-copy">
      <p class="eyebrow">DADA / {t(lang, "IN MOTION", "บนเวที")} <span>· {duration(clip)}</span></p>
      <h2 id="video-title">{clip[lang]}</h2>
      <p>{clip.description[lang]}</p>
      <p class="video-status" role="status" aria-live="polite"></p>
      <div class="video-links">
        {clip.event && <a class="text-link" href={`${eventPath(lang, clip.event)}#videos`}>{t(lang, "Explore the event", "ชมเรื่องราวของงาน")} ↗</a>}
        <a class="text-link" href={videoURL(clip)} target="_blank" rel="noopener noreferrer">{t(lang, "Open original player", "เปิดเครื่องเล่นแยก")} ↗</a>
      </div>
    </div>
  </template>
))}
