---
import Preferences from "../components/Preferences.astro";
import "@fontsource-variable/manrope";
import "@fontsource-variable/playfair-display";
import "@fontsource-variable/noto-sans-thai";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { cosplayHome } from "../data/cosplay";
import VideoDialog from "../components/VideoDialog.astro";
import { videos, videosFor } from "../data/videos";
import Photo from "../components/Photo.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { socials, resumeURL, portfolioURL } from "../data/portfolio";
import {
  base,
  origin,
  home,
  eventPath,
  t,
  type Lang,
  type EventCredit,
} from "../data/portfolio";
import { photo } from "../data/images";
interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  event?: EventCredit;
  noindex?: boolean;
}
const {
  lang,
  title = t(
    Astro.props.lang,
    "Dada — Thai–English MC & Content Creator | Kunwadee Phanompotivong",
    "Dada — พิธีกรไทย–อังกฤษ | Kunwadee Phanompotivong",
  ),
  description = t(
    Astro.props.lang,
    "Meet Dada: Thai–English MC, content creator and voice actor. Watch 12 video samples and explore 17 hosting credits, from festivals to brand presentations and formal ceremonies.",
    "รู้จัก Dada พิธีกรไทย–อังกฤษ คอนเทนต์ครีเอเตอร์ และนักพากย์เสียง ชม 12 วิดีโอและ 17 ผลงานพิธีกร ตั้งแต่เทศกาล งานนำเสนอสินค้า ไปจนถึงพิธีการ",
  ),
  event,
  noindex = false,
} = Astro.props;
const en = event ? eventPath("en", event.id) : home("en");
const th = event ? eventPath("th", event.id) : home("th");
const canonical = origin + (event ? eventPath(lang, event.id) : home(lang));
const image = `${origin}${base}/social/${event?.id || "dada-kunwadee"}.jpg`;
const imageAlt = event
  ? `${event[lang]} — Dada, Kunwadee Phanompotivong`
  : "Dada — Kunwadee Phanompotivong · Thai–English MC, creator & voice actor";
const person = {
  "@type": "Person",
  "@id": origin + home("en") + "#dada",
  name: "Kunwadee Phanompotivong",
  alternateName: "Dada",
  url: origin + home("en"),
  jobTitle: "Bilingual Master of Ceremonies",
  image: origin + photo("dada-portrait.jpg").src,
  knowsLanguage: ["Thai", "English"],
  sameAs: [
    ...socials.filter((s) => s.label !== "LINE").map((s) => s.url),
    "https://linktr.ee/keewadun",
  ],
};
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    person,
    {
      "@type": event ? "WebPage" : "ProfilePage",
      "@id": canonical,
      name: title,
      description,
      url: canonical,
      inLanguage: lang,
      about: { "@id": person["@id"] },
      ...(event ? {} : { mainEntity: { "@id": person["@id"] } }),
    },
    ...(event
      ? [
          {
            "@type": "BreadcrumbList",
            itemListElement: [
              {
                "@type": "ListItem",
                position: 1,
                name: "Dada",
                item: origin + home(lang),
              },
              {
                "@type": "ListItem",
                position: 2,
                name: event[lang],
                item: canonical,
              },
            ],
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <Preferences />
    <meta charset="utf-8" />

    <meta name="color-scheme" content="light dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#712d43" />
    <meta
      name="robots"
      content={
        noindex ? "noindex,follow" : "index,follow,max-image-preview:large"
      }
    />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={origin + en} />
    <link rel="alternate" hreflang="th" href={origin + th} />
    <link rel="alternate" hreflang="x-default" href={origin + en} />
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:site_name" content="Dada — Kunwadee" />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={lang === "th" ? "th_TH" : "en_US"} />
    <meta
      property="og:locale:alternate"
      content={lang === "th" ? "en_US" : "th_TH"}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
    />
  </head>
  <body>
    <div class="arrival-charm" aria-hidden="true">
      <svg viewBox="0 0 32 40" fill="none">
        <rect
          x="10"
          y="2"
          width="12"
          height="23"
          rx="6"
          stroke="currentColor"
          stroke-width="2"
        />
        <path
          d="M5 17v3a11 11 0 0 0 22 0v-3M16 31v7M10 38h12M13 8h6M13 13h6"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        />
      </svg>
      <span>dada ✳</span>
      <i></i>
    </div>
    <a href="#main" class="skip-link">
      {t(lang, "Skip to content", "ข้ามไปยังเนื้อหา")}
    </a>
    <div class="reading-progress" aria-hidden="true"></div>
    <header class="site-header">
      <a
        class="brand"
        href={home(lang)}
        aria-label={t(lang, "Dada home", "หน้าแรก Dada")}
      >
        dada<span aria-hidden="true">✳</span>
      </a>
      <nav
        class="main-nav"
        id="main-nav"
        aria-label={t(lang, "Main navigation", "เมนูหลัก")}
      >
        <a href={`${home(lang)}#about`}>
          {t(lang, "A little about me", "รู้จักกันอีกนิด")}
        </a>
        <a href={`${home(lang)}#work`}>
          {t(lang, "On the mic", "ผลงานบนเวที")}
        </a>
        <a href={`${home(lang)}#videos`}>{t(lang, "In motion", "วิดีโอ")}</a>
        <a href={`${home(lang)}#events`}>
          {t(lang, "All the moments", "ทุกช่วงเวลา")}
        </a>
      </nav>
      <div class="header-actions">
        <a
          class="cosplay-switch"
          href={cosplayHome(lang)}
          aria-label={t(
            lang,
            "Explore Dada’s cosplay portfolio",
            "ชมผลงานคอสเพลย์ Dada",
          )}
        >
          ✿ <span>Cosplay</span>
        </a>
        <div class="experience-controls">
          <div
            class="language-switch"
            data-language={lang}
            aria-label={t(lang, "Language", "ภาษา")}
          >
            <a
              href={en}
              lang="en"
              hreflang="en"
              aria-current={lang === "en" ? "page" : undefined}
            >
              EN
            </a>
            <a
              href={th}
              lang="th"
              hreflang="th"
              aria-current={lang === "th" ? "page" : undefined}
            >
              ไทย
            </a>
          </div>
          <button
            type="button"
            class="theme-toggle"
            data-theme-toggle
            aria-pressed="false"
            aria-label={t(lang, "Dark mode", "โหมดมืด")}
          >
            <span class="sun-icon" aria-hidden="true">
              ☀
            </span>
            <span class="moon-icon" aria-hidden="true">
              ☾
            </span>
            <span class="theme-knob" aria-hidden="true"></span>
          </button>
        </div>
        <a
          class="button small header-hello"
          href={`${home(lang)}#contact`}
          data-contact
        >
          {t(lang, "Say hello", "ทักทายกัน")} <span>↗</span>
        </a>
        <button
          class="menu-toggle"
          type="button"
          aria-label={t(lang, "Open menu", "เปิดเมนู")}
          aria-controls="menu-dialog"
          aria-expanded="false"
        >
          <span></span>
          <span></span>
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div class="footer-intro">
        <a class="brand" href={home(lang)}>
          dada<span aria-hidden="true">✳</span>
        </a>
        <p>
          Kunwadee Phanompotivong
          <br />
          <span>
            {t(
              lang,
              "A little heart. A lot of possibility.",
              "ใส่ใจในทุกโอกาสและทุกการสื่อสาร",
            )}
          </span>
        </p>
        <span class="footer-signature">
          {t(
            lang,
            "See you at the next hello.",
            "แล้วพบกันในคำทักทายครั้งต่อไป",
          )}{" "}
          ♡
        </span>
      </div>
      <div class="footer-connect">
        <p class="eyebrow">
          {t(lang, "STAY A LITTLE CLOSER", "มารู้จักกันอีกนิด")}
        </p>
        <SocialLinks lang={lang} />
        <div class="footer-essentials">
          <a href={cosplayHome(lang)}>
            <Icon name="sparkle" />
            <span>
              {t(
                lang,
                "Kayyalis — my cosplay universe",
                "Kayyalis — โลกคอสเพลย์ของด้า",
              )}{" "}
              ↗
            </span>
          </a>
          <a href="mailto:wwkunwadee05@gmail.com">
            <Icon name="mail" />
            <span>wwkunwadee05@gmail.com</span>
          </a>
          <a href="tel:+66969769369">
            <Icon name="phone" />
            <span>096-976-9369</span>
          </a>
          <a
            href="https://linktr.ee/keewadun"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="link" />
            <span>{t(lang, "All Dada’s links", "ลิงก์ทั้งหมดของ Dada")} ↗</span>
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>TH ↔ EN · BKK / CNX / CEI</span>
        <button
          type="button"
          class="preview-toggle"
          data-preview-toggle
          aria-pressed="false"
        >
          {t(lang, "Pause previews", "หยุดตัวอย่าง")}
        </button>
        <a
          href="#main"
          class="back-top"
          aria-label={t(lang, "Back to top", "กลับด้านบน")}
        >
          ↑
        </a>
      </div>
    </footer>
    <dialog id="menu-dialog" class="menu-dialog" aria-labelledby="menu-title">
      <button
        type="button"
        class="dialog-close"
        data-close
        aria-label={t(lang, "Close menu", "ปิดเมนู")}
      >
        ×
      </button>
      <div class="menu-inner">
        <div class="menu-kicker">
          <span class="brand">
            dada<span>✳</span>
          </span>
          <span>
            {t(
              lang,
              "A LITTLE WORLD OF POSSIBILITIES",
              "โลกเล็ก ๆ ที่เต็มไปด้วยโอกาส",
            )}
          </span>
        </div>
        <span class="menu-ticket">
          <Icon name="mic" />{" "}
          {t(lang, "YOUR BACKSTAGE PASS", "บัตรผ่านสู่หลังเวที")} <span>♡</span>
        </span>
        <h2 id="menu-title">
          {t(lang, "Where shall", "อยากรู้จัก")}{" "}
          <em>{t(lang, "we go?", "มุมไหน?")}</em>
        </h2>
        <div class="menu-grid">
          <nav
            class="drawer-nav"
            aria-label={t(lang, "Explore Dada", "สำรวจเรื่องราวของ Dada")}
          >
            <a href={`${home(lang)}#about`}>
              <small>
                <Icon name="sparkle" />
              </small>
              <span>{t(lang, "A little about me", "รู้จักกันอีกนิด")}</span>
              <i>↗</i>
            </a>
            <a href={`${home(lang)}#work`}>
              <small>
                <Icon name="mic" />
              </small>
              <span>{t(lang, "On the mic", "ผลงานบนเวที")}</span>
              <i>↗</i>
            </a>
            <a href={`${home(lang)}#videos`}>
              <small>
                <Icon name="film" />
              </small>
              <span>{t(lang, "In motion", "วิดีโอ")}</span>
              <i>↗</i>
            </a>
            <a href={`${home(lang)}#events`}>
              <small>
                <Icon name="document" />
              </small>
              <span>{t(lang, "All 17 moments", "ทั้ง 17 ช่วงเวลา")}</span>
              <i>↗</i>
            </a>
            <a href={`${home(lang)}#contact`}>
              <small>
                <Icon name="mail" />
              </small>
              <span>{t(lang, "Let’s connect", "มาทำความรู้จักกัน")}</span>
              <i>↗</i>
            </a>
            <a href={cosplayHome(lang)}>
              <small>
                <Icon name="sparkle" />
              </small>
              <span>{t(lang, "My cosplay universe", "โลกคอสเพลย์ของด้า")}</span>
              <i>↗</i>
            </a>
          </nav>
          <div class="menu-portrait">
            <Photo name="dada-portrait.jpg" alt="Dada" sizes="250px" />
            <span>TH / EN · ON & OFF STAGE</span>
          </div>
        </div>
        <SocialLinks lang={lang} />
        <div class="menu-resources">
          <a href={portfolioURL} target="_blank" rel="noopener noreferrer">
            {t(lang, "Portfolio", "พอร์ตโฟลิโอ")} ↗
          </a>
          <a href={resumeURL} target="_blank" rel="noopener noreferrer">
            {t(lang, "Résumé", "เรซูเม่")} ↗
          </a>
          <a href="tel:+66969769369">096-976-9369 ↗</a>
        </div>
      </div>
    </dialog>
    <dialog
      class="contact-dialog"
      id="contact-dialog"
      aria-labelledby="contact-title"
    >
      <button
        type="button"
        class="dialog-close"
        data-close
        aria-label={t(lang, "Close contact", "ปิดหน้าต่างติดต่อ")}
      >
        ×
      </button>
      <div class="contact-dialog-inner">
        <span class="hello-emblem" aria-hidden="true">
          <Icon name="mail" />
          <i>♡</i>
        </span>
        <span class="pill">
          {t(
            lang,
            "GOOD CONVERSATIONS START HERE",
            "เริ่มต้นบทสนทนาดี ๆ ที่นี่",
          )}
        </span>
        <h2 id="contact-title">
          {t(lang, "Oh, hello!", "สวัสดี!")} <em>☺</em>
        </h2>
        <p>
          {t(
            lang,
            "A stage to host? A story to tell? Share your event, date, location, and the languages you have in mind.",
            "มีเวทีให้ดำเนินรายการ หรือเรื่องราวที่อยากเล่า? ส่งรายละเอียดงาน วันที่ สถานที่ และภาษาที่ต้องการมาได้เลย",
          )}
        </p>
        <div
          class="service-picker"
          role="group"
          aria-label={t(lang, "What shall we create?", "อยากร่วมงานด้านไหน?")}
        >
          <button type="button" data-service="Hosting" aria-pressed="false">
            <Icon name="mic" />
            {t(lang, "Hosting", "พิธีกร")}
          </button>
          <button type="button" data-service="Content" aria-pressed="false">
            <Icon name="film" />
            {t(lang, "Content", "คอนเทนต์")}
          </button>
          <button type="button" data-service="Voice work" aria-pressed="false">
            <Icon name="sparkle" />
            {t(lang, "Voice work", "งานเสียง")}
          </button>
        </div>
        <a
          class="contact-option"
          href="https://line.me/ti/p/iLlNAWNNnR"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>
            <span class="contact-logo">
              <Icon name="LINE" />
            </span>
            <small>LINE</small>
            {t(lang, "Let’s start a conversation", "เริ่มต้นพูดคุยกัน")}
          </span>
          <span>↗</span>
        </a>
        <a
          class="contact-option"
          data-booking-email
          href="mailto:wwkunwadee05@gmail.com"
        >
          <span>
            <span class="contact-logo">
              <Icon name="mail" />
            </span>
            <small>EMAIL</small>wwkunwadee05@gmail.com
          </span>
          <span>↗</span>
        </a>
        <a class="contact-option" href="tel:+66969769369">
          <span>
            <span class="contact-logo">
              <Icon name="phone" />
            </span>
            <small>{t(lang, "PHONE", "โทรศัพท์")}</small>096-976-9369
          </span>
          <span>↗</span>
        </a>
        <SocialLinks lang={lang} />
        <div class="contact-resources">
          <a href={portfolioURL} target="_blank" rel="noopener noreferrer">
            {t(lang, "Portfolio", "พอร์ตโฟลิโอ")} ↗
          </a>
          <a href={resumeURL} target="_blank" rel="noopener noreferrer">
            {t(lang, "Résumé", "เรซูเม่")} ↗
          </a>
          <a href={`${home(lang)}#videos`} data-close-on-navigate>
            {t(lang, "Watch video samples", "ชมตัวอย่างวิดีโอ")} ↗
          </a>
        </div>
        <button type="button" class="copy-email text-button">
          {t(lang, "Copy email address", "คัดลอกอีเมล")} <span>⧉</span>
        </button>
        <p class="copy-status" role="status" aria-live="polite"></p>
      </div>
    </dialog>
    <script>
      import "../scripts/interactions";
    </script>
    <VideoDialog clips={event ? videosFor(event.id) : videos} lang={lang} />
  </body>
</html>
